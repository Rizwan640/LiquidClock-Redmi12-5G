<?xml version="1.0" encoding="utf-8"?>
<Lockscreen version="1" frameRate="30" useVariableUpdater="DateTime.Minute" screenWidth="1080" useHardwareCanvas="true">
    <!-- Use the phone's current system wallpaper. -->
    <Wallpaper />

    <!-- Liquid Glass-inspired panel: translucent fill and edge highlights.
         MAML transparency is not live backdrop blur. -->
    <Rectangle x="54" y="420" w="972" h="500"
        cornerRadius="54"
        fillColor="#2bffffff"
        strokeColor="#70ffffff"
        weight="3"
        strokeAlign="center">
        <FillShaders>
            <LinearGradient x="0" y="0" x1="0" y1="500" tile="clamp">
                <GradientStop color="#42ffffff" position="0" />
                <GradientStop color="#1affffff" position="0.48" />
                <GradientStop color="#12ffffff" position="1" />
            </LinearGradient>
        </FillShaders>
    </Rectangle>

    <Rectangle x="72" y="438" w="936" h="464"
        cornerRadius="42"
        fillColor="#00ffffff"
        strokeColor="#36ffffff"
        weight="2"
        strokeAlign="inner" />

    <DateTime x="112" y="520" size="46"
        color="#f5ffffff"
        fontFamily="miui-regular"
        format="EEE, dd MMM" />

    <DateTime x="112" y="700" size="174"
        color="#ffffffff"
        fontFamily="miui-light"
        format="HH:mm" />

    <Rectangle x="112" y="455" w="260" h="4"
        cornerRadius="2"
        fillColor="#88ffffff" />

    <Text x="540" y="#screen_height-80"
        align="center"
        color="#d9ffffff"
        size="30"
        text="Swipe up to unlock" />

    <!-- Full-screen swipe area following Xiaomi Theme Designer's documented
         MAML Unlocker geometry. Actual HyperOS behavior still needs testing. -->
    <Unlocker name="Unlocker">
        <StartPoint x="0" y="0" w="1080" h="#screen_height" />
        <EndPoint x="0" y="-#screen_height" w="1080" h="#screen_height-200">
            <Path tolerance="800">
                <Position x="0" y="0" />
                <Position x="0" y="-#screen_height" />
            </Path>
        </EndPoint>
    </Unlocker>
</Lockscreen>
